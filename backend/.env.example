DATABASE_URL=mysql+asyncmy://user:password@127.0.0.1:3306/ebaphone?charset=utf8mb4
APP_ENV=production
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=ebaphone
JWT_AUDIENCE=ebaphone-web
CORS_ORIGINS=https://your-store.example.com,https://admin.your-store.example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
# Customer accounts use SMS verification only.  Keep the legacy password
# endpoints disabled unless a time-limited migration explicitly requires them.
LEGACY_PASSWORD_AUTH_ENABLED=false
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_WINDOW_SECONDS=900
ADMIN_LOGIN_IP_MAX_FAILURES=30
ADMIN_LOGIN_IP_WINDOW_SECONDS=60

STOCK_RESERVATION_TTL_MINUTES=30
STOCK_RESERVATION_SWEEP_SECONDS=60
# Hold one unit when an order is created, so concurrent checkouts cannot all
# pass a read-only availability check.  The hold is released by the normal
# reservation sweeper if payment is abandoned.
RESERVE_STOCK_ON_ORDER_CREATE=true

# SMS login follows the supplied SmsService contract: six digits, 300-second
# validity, 60-second resend cooldown and the login message template.
# Leave SMS_PROVIDER_URL empty only for local simulated delivery.
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
SMS_PROVIDER_FROM=EBAphone
SMS_MESSAGE_TEMPLATE=Your EBAphone verification code is {code}
SMS_RESEND_COOLDOWN_SECONDS=60
SMS_MAX_SENDS_PER_HOUR=5
SMS_EXPOSE_TEST_CODE=false
OTP_HASH_SECRET=replace-with-a-long-random-secret
# Optional dedicated key-encryption secret for the support assistant API key.
# If omitted, the key is derived from JWT_SECRET; changing JWT_SECRET then
# requires re-entering the assistant API key in the admin console.
LLM_CONFIG_ENCRYPTION_KEY=

HUBTEL_ACCOUNT_NUMBER=your_merchant_account_number
HUBTEL_API_ID=your_api_id
HUBTEL_API_KEY=your_api_key
HUBTEL_WEBHOOK_SECRET=replace-with-the-callback-hmac-secret
HUBTEL_CALLBACK_URL=https://your-public-api.example.com/api/v1/callback/payNotify
HUBTEL_REFUND_CALLBACK_URL=https://your-public-api.example.com/api/v1/callback/refundNotify
HUBTEL_RETURN_URL=https://your-store.example.com/payment/return
HUBTEL_CANCELLATION_URL=https://your-store.example.com/payment/cancel
